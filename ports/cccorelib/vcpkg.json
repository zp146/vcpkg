{
  "name": "cccorelib",
  "version-string": "1.0.0",
  "description": "Core CloudCompare data structures & algorithms for handling point clouds",
  "homepage": "https://github.com/zp146/CCCoreLib",
  "dependencies": [
     {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    { "name": "nanoflann" }
  ],
  "features": {
    "cgal": {
      "description": "Enable CGAL-based algorithms",
      "dependencies": [
        { "name": "cgal", "default-features": false },
        { "name": "gmp" }
      ]
    },
    "qtconcurrent": {
      "description": "Enable QtConcurrent-based parallel features",
      "dependencies": [
        "qt5-base"
      ]
    },
    "tbb": {
      "description": "Enable TBB-based parallel features",
      "dependencies": [
        "tbb"
      ]
    }
  },
  "builtin-baseline": "bcf3d00d2116056fda0ce47615f6074ffecb7524",
  "overrides": [
    { "name": "cgal", "version": "5.6.1" },
    { "name": "nanoflann", "version": "1.5.5" },
    { "name": "gmp", "version": "6.3.0#2" }
  ]
}